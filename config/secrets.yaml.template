# ローカル環境固有の設定（Git 管理対象外）
#
# 初回セットアップ:
#   cp config/secrets.yaml.template config/secrets.yaml
#   # secrets.yaml を編集してから setup_workdir_symlinks.sh を実行
#
# 読み込み元: Snakefile 01, 02, 03, 05（configfile: 'config/secrets.yaml'）

# 生成データの作業ディレクトリ（大容量ファイルは HDD 等を推奨）
wdir: "/mnt/hdd/USER/ATTED-II_work"

# KEGG FTP 認証情報（Step 05 評価データ準備で使用）
# https://www.kegg.jp/kegg/docs/ftp.html より取得
kegg_ftp_user: "your_kegg_username"
kegg_ftp_pass: "your_kegg_password"
